{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "nebula-studio",
  "version": "0.0.0",
  "description": "Nebula Studio desktop and web workspace for integration development and platform management.",
  "private": true,
  "homepage": "https://github.com/LiaoHan5426/nebula-studio#readme",
  "bugs": {
    "url": "https://github.com/LiaoHan5426/nebula-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiaoHan5426/nebula-studio.git"
  },
  "license": "UNLICENSED",
  "author": "Liao Han <liaohan5426@gmail.com>",
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp run lint --threads 2 && vp run test && vp run build && vp run check:editors",
    "build": "vp run -r build",
    "build:unpack": "vp run electron#build:unpack",
    "build:federation-remotes": "vp run --filter @nebula-studio-renderer/docs --filter @nebula-studio-renderer/settings --filter @nebula-studio-renderer/integration --filter @nebula-studio-renderer/low-code-studio build",
    "pack:win": "vp run build:federation-remotes && vp run electron#pack:win",
    "pack:mac": "vp run build:federation-remotes && vp run electron#pack:mac",
    "pack:linux": "vp run build:federation-remotes && vp run electron#pack:linux",
    "dev": "vp run electron#dev",
    "start": "vp run electron#start",
    "dev:electron": "vp run electron#dev",
    "dev:web": "vp run web#dev",
    "build:web": "vp run build:federation-remotes && vp run web#build",
    "check:bundle": "nebula-vsh check-bundle",
    "check:css-sources": "nebula-vsh check-css-sources",
    "check:boundaries": "nebula-vsh check-boundaries",
    "check:inventory": "nebula-vsh check-inventory",
    "check:b-inventory": "nebula-vsh check-b-inventory",
    "check:circular": "nebula-vsh scan-circular",
    "check:workspace": "nebula-vsh check-workspace",
    "check:editors": "nebula-vsh check-editor-boundaries && vp run @nebula-studio/nebula-code-editor#typecheck && vp run @nebula-studio/nebula-code-editor#test && vp run @nebula-studio/nebula-code-editor#build && vp run @nebula-studio/nebula-code-editor#check:bundle",
    "check:mf-poc": "nebula-vsh check-mf-poc",
    "check:docs-mf": "nebula-vsh check-docs-mf",
    "check:settings-mf": "nebula-vsh check-settings-mf",
    "check:integration-mf": "nebula-vsh check-integration-mf",
    "check:login-host": "nebula-vsh check-login-host",
    "check:host-workspace": "nebula-vsh check-host-workspace",
    "check:iframe-driver": "nebula-vsh check-iframe-driver",
    "check:remote-resilience": "nebula-vsh check-remote-resilience",
    "check:federation": "nebula-vsh check-boundaries && nebula-vsh check-inventory && nebula-vsh check-remote-resilience && nebula-vsh scan-circular && vp run --filter @nebula-studio/host-capabilities test && vp run --filter @nebula-studio/application-runtime test && vp run --filter @nebula-studio/federation-protocol test && vp run --filter @nebula-studio-internal/build-kit test && vp run --filter @nebula-studio-internal/node-kit test",
    "dev:mf-poc": "vp run mf-poc-host#dev",
    "dev:mf-poc:electron": "node ./apps/mf-poc-host/electron-poc/launch.mjs",
    "dev:mf-poc:electron-file": "node ./apps/mf-poc-host/electron-poc/launch.mjs --file",
    "check:generated": "nebula-vsh check-generated",
    "soak:low-code": "node ./scripts/low-code-soak.mjs",
    "cap": "vp run mobile#cap",
    "check": "vp check --fix",
    "lint:ox": "vp lint --fix --threads=2",
    "lint:eslint": "vp exec eslint . --fix --cache",
    "lint:style": "vp exec stylelint \"**/*.{css,scss,vue}\" --fix --allow-empty-input --ignore-pattern \"**/out/**\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/dev-dist/**\"",
    "lint": "vp run lint:ox && vp run lint:eslint && vp run lint:style",
    "test": "vp run -r test",
    "test:e2e": "vp run test:e2e:mock",
    "test:e2e:mock": "vp exec playwright test --project=mock-regression",
    "test:e2e:experience": "vp exec playwright test --project=experience",
    "test:e2e:live-web": "vp exec playwright test --project=live-web",
    "test:e2e:standalone": "vp exec playwright test -c playwright.standalone.config.ts",
    "test:e2e:real": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/e2e/run-real-stack.ps1",
    "test:e2e:electron": "vp run build:federation-remotes && vp run electron#build && vp exec playwright test --project=electron",
    "test:all": "vp run -r test && vp run test:e2e:mock && vp run test:e2e:experience",
    "postinstall": "vp run -r stub --if-present",
    "prepare": "vp config",
    "update:deps": "vp dlx taze -r -w",
    "clean": "node ./scripts/clean.mjs",
    "generate:configs": "node ./scripts/generate-window-configs.mjs",
    "generate:manifest": "node ./scripts/generate-window-configs.mjs",
    "generate:contracts": "node ./scripts/generate-contracts.mjs",
    "generate:contracts:strict": "node ./scripts/generate-contracts.mjs --strict",
    "devlog": "node ./scripts/devlog.mjs",
    "changeset": "vp exec changeset",
    "lint:commits": "vp exec commitlint --last --verbose"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:release",
    "@commitlint/cli": "catalog:lint",
    "@nebula-studio-internal/commitlint": "workspace:^",
    "@nebula-studio-internal/eslint": "workspace:^",
    "@nebula-studio-internal/node-kit": "workspace:^",
    "@nebula-studio-internal/oxfmt": "workspace:^",
    "@nebula-studio-internal/oxlint": "workspace:^",
    "@nebula-studio-internal/stylelint": "workspace:^",
    "@nebula-studio-internal/tsconfig": "workspace:^",
    "@nebula-studio/types": "workspace:^",
    "@playwright/test": "catalog:test",
    "@vitejs/plugin-vue": "catalog:vite",
    "@vitejs/plugin-vue-jsx": "catalog:vite",
    "ajv": "catalog:",
    "cross-env": "catalog:utils",
    "eslint": "catalog:lint",
    "esno": "catalog:utils",
    "happy-dom": "catalog:vite",
    "openapi-typescript": "catalog:",
    "tailwindcss": "catalog:style",
    "unconfig": "catalog:utils",
    "vite-plus": "catalog:vite",
    "vitest": "catalog:vite"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
