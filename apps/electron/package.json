{
  "name": "@nebula-studio/electron",
  "version": "0.0.0",
  "description": "Nebula Studio Electron desktop host.",
  "private": true,
  "homepage": "https://github.com/LiaoHan5426/nebula-studio#readme",
  "bugs": {
    "url": "https://github.com/LiaoHan5426/nebula-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiaoHan5426/nebula-studio.git",
    "directory": "apps/electron"
  },
  "license": "UNLICENSED",
  "author": "Liao Han <liaohan5426@gmail.com>",
  "scripts": {
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.renderer.json --composite false",
    "typecheck:renderers": "vp run --filter \"@nebula-studio-renderer/*\" typecheck",
    "typecheck": "vp run typecheck:node && vp run typecheck:web && vp run typecheck:renderers",
    "start": "vp exec electron-vite preview",
    "dev": "vp exec electron-vite dev",
    "build": "vp run typecheck && vp exec electron-vite build",
    "build:unpack": "vp run build && vp exec electron-builder --dir",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "pack:win": "vp run build && vp exec electron-builder --win",
    "pack:mac": "vp run build && vp exec electron-builder --mac",
    "pack:linux": "vp run build && vp exec electron-builder --linux"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@nebula-studio-electron/electron-bridge": "workspace:^",
    "@nebula-studio/app-shell": "workspace:^",
    "@nebula-studio/application-runtime": "workspace:^",
    "@nebula-studio/auth-provider": "workspace:^",
    "@nebula-studio/contracts": "workspace:^",
    "@nebula-studio/federation-protocol": "workspace:^",
    "@nebula-studio/host-capabilities": "workspace:^",
    "@nebula-studio/shell-host": "workspace:^",
    "@nebula-studio/shell-protocol": "workspace:^",
    "@nebula-studio/tokens": "workspace:^",
    "electron-updater": "catalog:electron",
    "yaml": "catalog:parser"
  },
  "devDependencies": {
    "@nebula-studio-internal/build-kit": "workspace:^",
    "@nebula-studio-internal/tsconfig": "workspace:^",
    "@nebula-studio-renderer/assembly-boot": "workspace:^",
    "@nebula-studio/application-bootstrap": "workspace:^",
    "@nebula-studio/login-ui": "workspace:^",
    "@nebula-studio/msw": "workspace:^",
    "@nebula-studio/nebula-layout": "workspace:^",
    "@nebula-studio/nebula-ui": "workspace:^",
    "@nebula-studio/styles": "workspace:^",
    "@nebula-studio/types": "workspace:^",
    "@types/node": "catalog:types",
    "electron": "catalog:electron",
    "electron-builder": "catalog:electron",
    "electron-vite": "catalog:electron",
    "typescript": "catalog:types",
    "vite": "catalog:vite",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  },
  "packageManager": "pnpm"
}
