{
  "extends": "@nebula-studio-internal/tsconfig/node.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.node.tsbuildinfo",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["electron-vite/node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["electron.vite.config.*", "app.config.ts", "src/main/**/*"]
}
