{
  "name": "@nebula-studio/styles",
  "version": "0.0.0",
  "description": "Shared design tokens and global styles for Nebula Studio.",
  "private": true,
  "homepage": "https://github.com/LiaoHan5426/nebula-studio#readme",
  "bugs": {
    "url": "https://github.com/LiaoHan5426/nebula-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiaoHan5426/nebula-studio.git",
    "directory": "packages/styles"
  },
  "license": "UNLICENSED",
  "author": "Liao Han <liaohan5426@gmail.com>",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/document.ts",
    "./src/remote.ts"
  ],
  "exports": {
    ".": "./src/index.css",
    "./index.css": "./src/index.css",
    "./document": "./src/document.ts",
    "./remote": "./src/remote.ts",
    "./tokens/root.css": "./src/tokens/root.css",
    "./tokens/semantic-light.css": "./src/tokens/semantic-light.css",
    "./tokens/semantic-dark.css": "./src/tokens/semantic-dark.css",
    "./foundations/theme-motion.css": "./src/foundations/theme-motion.css"
  },
  "dependencies": {
    "@nebula-studio-internal/tailwind": "workspace:^",
    "tailwindcss": "catalog:style"
  }
}
