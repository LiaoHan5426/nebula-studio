{
  "name": "@nebula-studio/nebula-code-editor",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-neutral, lazy-loaded code editor facade for Nebula Studio.",
  "author": "Liao Han <liaohan5426@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/LiaoHan5426/nebula-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiaoHan5426/nebula-studio.git",
    "directory": "packages/editors/code-editor"
  },
  "bugs": {
    "url": "https://github.com/LiaoHan5426/nebula-studio/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./monaco": {
      "types": "./src/providers/monaco/index.ts",
      "default": "./src/providers/monaco/index.ts"
    }
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "test": "vp test run",
    "build": "vite build",
    "check:bundle": "node ./scripts/check-bundle-budget.mjs"
  },
  "peerDependencies": {
    "vue": "catalog:vue"
  },
  "dependencies": {
    "monaco-editor": "catalog:editor",
    "monaco-editor-vue3": "catalog:editor"
  },
  "devDependencies": {
    "@nebula-studio-internal/tsconfig": "workspace:^",
    "@nebula-studio/types": "workspace:^",
    "@vitejs/plugin-vue": "catalog:vite",
    "happy-dom": "catalog:vite",
    "vite": "catalog:vite",
    "vite-plus": "catalog:vite",
    "vitest": "catalog:vite",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
