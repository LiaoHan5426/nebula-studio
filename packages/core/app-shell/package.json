{
  "name": "@nebula-studio/app-shell",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Web and Electron application shell integration for Nebula Studio.",
  "author": "Liao Han <liaohan5426@gmail.com>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/LiaoHan5426/nebula-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiaoHan5426/nebula-studio.git",
    "directory": "packages/core/app-shell"
  },
  "bugs": {
    "url": "https://github.com/LiaoHan5426/nebula-studio/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
