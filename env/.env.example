# Copy keys into env/.env.[mode].local for machine-specific overrides (gitignored).
# Select mode: NEBULA_ENV=development|preview|production (aliases: dev, product, prod, staging)

# Backend API origins (absolute http(s) origins, no trailing path)
NEBULA_PLATFORM_TARGET=http://localhost:8090
NEBULA_CONSOLE_TARGET=http://localhost:8080
NEBULA_EXECUTOR_TARGET=http://localhost:8088

# Federation dev tooling (optional overrides; defaults also in configs/federation-dev.json)
NEBULA_FEDERATION_DEV_HOST=127.0.0.1
NEBULA_FEDERATION_REMOTE_CACHE_DIR=node_modules/.vite/federation-remotes
