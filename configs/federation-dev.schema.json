{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["federationDev"],
  "properties": {
    "$schema": { "type": "string" },
    "federationDev": {
      "type": "object",
      "required": ["host", "remoteCacheDir"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "remoteCacheDir": { "type": "string", "minLength": 1 }
      }
    },
    "federationDevEntries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "expose", "packagedHost", "defaultHttpEntry"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "expose": { "type": "string" },
          "packagedHost": { "type": "string" },
          "defaultHttpEntry": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
