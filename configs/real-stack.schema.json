{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["healthChecks", "openapi"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "probeHost": { "type": "string" },
    "healthChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "target", "startupPath", "probePath"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "target": { "type": "string" },
          "startupPath": { "type": "string", "pattern": "^/" },
          "probePath": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "openapi": { "type": "object" },
    "unauthorizedProbe": { "type": "object" }
  }
}
