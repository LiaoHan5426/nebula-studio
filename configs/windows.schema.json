{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nebula Studio Windows Configuration",
  "description": "Centralized window/renderer and runtime-address configuration for Nebula Studio Electron and Web modes.",
  "type": "object",
  "required": [
    "windows",
    "apiBases",
    "apiTargets",
    "apiProxy",
    "realStack",
    "e2e"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web"],
      "properties": {
        "topInsetPx": {
          "type": "number",
          "minimum": 0,
          "description": "Top inset for the shell window (px)."
        },
        "web": {
          "$ref": "#/definitions/DevServerAddress",
          "description": "Integrated Web Shell dev server address."
        },
        "electron": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rendererEntry": {
              "type": "string",
              "description": "Packaged Electron renderer HTML path relative to the app output."
            }
          }
        },
        "embedQuery": {
          "type": "string",
          "minLength": 1,
          "description": "Query parameter used by the Web Shell to select an embed surface."
        }
      }
    },
    "electronEmbeddedPresentation": {
      "type": "string",
      "enum": ["iframe", "browser-view"],
      "description": "How Electron embeds sub-app renderers."
    },
    "apiBases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^/" },
      "description": "API namespace to browser-relative base path."
    },
    "apiTargets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      },
      "description": "API namespace to origin URL used by Vite proxy, real-stack, and OpenAPI."
    },
    "apiProxy": {
      "$ref": "#/definitions/ApiProxyConfig"
    },
    "realStack": {
      "$ref": "#/definitions/RealStackConfig"
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mockRoutePatterns"],
      "properties": {
        "mockRoutePatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Playwright route patterns allowed for mock/experience projects."
        }
      }
    },
    "windows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/WindowConfig"
      },
      "description": "Named window definitions. Keys are window IDs."
    },
    "modalRenderers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ModalRendererConfig"
      },
      "description": "Modal renderer definitions (non-window, overlay renderers)."
    },
    "displayOrder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Ordered list of window IDs for display in navigation."
    }
  },
  "definitions": {
    "DevServerAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "basePath": { "type": "string", "pattern": "^/" }
      }
    },
    "StandaloneAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "basePath": { "type": "string", "pattern": "^/" }
      }
    },
    "ApiProxyRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "target"],
      "properties": {
        "prefix": { "type": "string", "pattern": "^/" },
        "target": { "type": "string", "minLength": 1 },
        "injectExecutorServiceToken": { "type": "boolean" }
      }
    },
    "ApiProxyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presets"],
      "properties": {
        "presets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integration", "standard"],
          "properties": {
            "integration": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/ApiProxyRoute" }
            },
            "standard": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/ApiProxyRoute" }
            }
          }
        }
      }
    },
    "RealStackHealthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "target", "startupPath", "probePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "startupPath": { "type": "string", "pattern": "^/" },
        "probePath": { "type": "string", "pattern": "^/" }
      }
    },
    "RealStackConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthChecks", "openapi"],
      "properties": {
        "probeHost": { "type": "string", "minLength": 1 },
        "healthChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/RealStackHealthCheck" }
        },
        "openapi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform"],
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "path"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "pattern": "^/" }
              }
            }
          }
        },
        "unauthorizedProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "path"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "PreloadCapability": {
      "type": "string",
      "enum": ["auth", "notify", "settings", "shell"],
      "description": "A capability that can be exposed to a window's preload script."
    },
    "WindowConfig": {
      "type": "object",
      "required": ["preload", "renderer", "label", "preloadCapabilities"],
      "additionalProperties": false,
      "properties": {
        "preload": {
          "type": "string",
          "description": "Preload script ID to use (maps to unified preload virtual entry)."
        },
        "renderer": {
          "type": "string",
          "description": "Renderer package name (maps to apps/sub-web/<name>/src/main.ts)."
        },
        "webEmbedEntry": {
          "type": "string",
          "pattern": "^\\./embed/.+-entry\\.js$",
          "description": "Optional Web shell embed entry, relative to apps/web/src."
        },
        "label": {
          "type": "string",
          "description": "Human-readable window label."
        },
        "description": {
          "type": "string",
          "description": "Short task-oriented description used by Shell search and launch surfaces."
        },
        "category": {
          "type": "string",
          "enum": ["workspace", "product", "support", "settings"],
          "description": "Shell navigation and launcher category."
        },
        "helpKey": {
          "type": "string",
          "description": "Stable contextual help key."
        },
        "searchKeywords": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Additional global-search keywords."
        },
        "roles": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "Roles allowed to discover this Shell entry."
        },
        "returnTo": {
          "type": "string",
          "description": "Default route or Shell surface used when returning to this entry."
        },
        "iconSvg": {
          "type": "string",
          "description": "Inline SVG markup for the window icon."
        },
        "defaultEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether this window is enabled by default."
        },
        "integratable": {
          "type": "boolean",
          "default": false,
          "description": "Whether this window can be embedded inside the integration sub-app."
        },
        "requiresAuth": {
          "type": "boolean",
          "default": false,
          "description": "Whether this window requires authentication to access."
        },
        "preloadCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreloadCapability"
          },
          "uniqueItems": true,
          "description": "List of capabilities to expose in this window's preload script."
        },
        "proxyPreset": {
          "type": "string",
          "enum": ["integration", "standard"],
          "description": "Vite API proxy preset used when this renderer runs standalone."
        },
        "standalone": {
          "$ref": "#/definitions/StandaloneAddress"
        }
      }
    },
    "ModalRendererConfig": {
      "type": "object",
      "required": ["preload", "renderer", "preloadCapabilities"],
      "additionalProperties": false,
      "properties": {
        "preload": {
          "type": "string",
          "description": "Preload script ID to use."
        },
        "renderer": {
          "type": "string",
          "description": "Renderer package name."
        },
        "webEmbedEntry": {
          "type": "string",
          "pattern": "^\\./embed/.+-entry\\.js$",
          "description": "Optional Web shell embed entry, relative to apps/web/src."
        },
        "preloadCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreloadCapability"
          },
          "uniqueItems": true,
          "description": "List of capabilities to expose in this modal's preload script."
        },
        "proxyPreset": {
          "type": "string",
          "enum": ["integration", "standard"],
          "description": "Vite API proxy preset used when this renderer runs standalone."
        },
        "standalone": {
          "$ref": "#/definitions/StandaloneAddress"
        }
      }
    }
  }
}
