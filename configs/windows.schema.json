{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nebula Studio Windows Configuration",
  "description": "Electron window/preload/renderer, apiTargets, realStack probes, and E2E patterns. Product labels, categories, and display order live in the backend application registry, not on WindowConfig.",
  "type": "object",
  "required": ["windows", "apiTargets", "realStack", "e2e"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web"],
      "properties": {
        "topInsetPx": {
          "type": "number",
          "minimum": 0,
          "description": "Top inset for the shell window (px)."
        },
        "web": {
          "$ref": "#/definitions/DevServerAddress",
          "description": "Integrated Web Shell dev server address."
        },
        "electron": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rendererEntry": {
              "type": "string",
              "description": "Packaged Electron renderer HTML path relative to the app output."
            }
          }
        },
        "embedQuery": {
          "type": "string",
          "minLength": 1,
          "description": "Query parameter used by the Web Shell to select an embed surface."
        }
      }
    },
    "electronEmbeddedPresentation": {
      "type": "string",
      "enum": ["iframe", "browser-view"],
      "description": "How Electron embeds sub-app renderers."
    },
    "apiTargets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      },
      "description": "Backend origin URLs keyed by target name (platform, console, executor). Browser API path prefixes and Vite proxy routes are a code black box, not operator configuration."
    },
    "realStack": {
      "$ref": "#/definitions/RealStackConfig"
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mockRoutePatterns"],
      "properties": {
        "mockRoutePatterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Playwright route patterns allowed for mock/experience projects."
        }
      }
    },
    "windows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/WindowConfig"
      },
      "description": "Named window definitions. Keys are window IDs."
    },
    "modalRenderers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/ModalRendererConfig"
      },
      "description": "Modal renderer definitions (non-window, overlay renderers)."
    }
  },
  "definitions": {
    "DevServerAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "basePath": { "type": "string", "pattern": "^/" }
      }
    },
    "StandaloneAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "basePath": { "type": "string", "pattern": "^/" }
      }
    },
    "RealStackHealthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "target", "startupPath", "probePath"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "startupPath": { "type": "string", "pattern": "^/" },
        "probePath": { "type": "string", "pattern": "^/" }
      }
    },
    "RealStackConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthChecks", "openapi"],
      "properties": {
        "probeHost": { "type": "string", "minLength": 1 },
        "healthChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/RealStackHealthCheck" }
        },
        "openapi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform"],
          "properties": {
            "platform": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "path"],
              "properties": {
                "target": { "type": "string", "minLength": 1 },
                "path": { "type": "string", "pattern": "^/" }
              }
            }
          }
        },
        "unauthorizedProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "path"],
          "properties": {
            "target": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "pattern": "^/" }
          }
        }
      }
    },
    "PreloadCapability": {
      "type": "string",
      "enum": ["auth", "notify", "settings", "shell"],
      "description": "A capability that can be exposed to a window's preload script."
    },
    "WindowConfig": {
      "type": "object",
      "required": ["preload", "renderer", "preloadCapabilities"],
      "additionalProperties": false,
      "properties": {
        "preload": {
          "type": "string",
          "description": "Preload script ID to use (maps to unified preload virtual entry)."
        },
        "renderer": {
          "type": "string",
          "description": "Renderer package name (maps to apps/sub-web/<name>/src/main.ts)."
        },
        "webEmbedEntry": {
          "type": "string",
          "pattern": "^\\./embed/.+-entry\\.js$",
          "description": "Optional Web shell embed entry, relative to apps/web/src."
        },
        "webLoad": {
          "type": "string",
          "enum": ["embed", "federation", "host"],
          "description": "Web shell load driver. host is owned by apps/web boot (no generated embed entry). federation uses a Remote manifest instead of webEmbedEntry."
        },
        "preloadCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreloadCapability"
          },
          "uniqueItems": true,
          "description": "List of capabilities to expose in this window's preload script."
        },
        "proxyPreset": {
          "type": "string",
          "enum": ["integration", "standard"],
          "description": "Vite API proxy preset used when this renderer runs standalone."
        },
        "standalone": {
          "$ref": "#/definitions/StandaloneAddress"
        }
      }
    },
    "ModalRendererConfig": {
      "type": "object",
      "required": ["preload", "renderer", "preloadCapabilities"],
      "additionalProperties": false,
      "properties": {
        "preload": {
          "type": "string",
          "description": "Preload script ID to use."
        },
        "renderer": {
          "type": "string",
          "description": "Renderer package name."
        },
        "webEmbedEntry": {
          "type": "string",
          "pattern": "^\\./embed/.+-entry\\.js$",
          "description": "Optional Web shell embed entry, relative to apps/web/src."
        },
        "webLoad": {
          "type": "string",
          "enum": ["embed", "federation", "host"],
          "description": "Web shell load driver. host is owned by apps/web boot (no generated embed entry). federation uses a Remote manifest instead of webEmbedEntry."
        },
        "preloadCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PreloadCapability"
          },
          "uniqueItems": true,
          "description": "List of capabilities to expose in this modal's preload script."
        },
        "proxyPreset": {
          "type": "string",
          "enum": ["integration", "standard"],
          "description": "Vite API proxy preset used when this renderer runs standalone."
        },
        "standalone": {
          "$ref": "#/definitions/StandaloneAddress"
        }
      }
    }
  }
}
